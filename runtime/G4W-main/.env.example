# G4W Portable environment
# Runtime paths are derived from the launcher location and are not stored here.
G4W_ENV_VERSION=2

G4W_USER_NAME=
G4W_USER_IDENTITY=
G4W_USER_GENDER=neutral
G4W_BOT_NAME=
G4W_ACCOUNT_ID=

G4W_CONDUCTOR_MODEL=deepseek-v4-flash
G4W_WORKER_MODEL=deepseek-v4-flash
G4W_PRO_MODEL=deepseek-v4-pro

G4W_TIMELINE_LOCALE=zh-CN
G4W_TIMELINE_UI_THEME=default

G4W_DIDA_COMMAND=
G4W_DIDA_TOKEN=
G4W_TODAY_TASK_AUTH_CODE=

G4W_CHECKIN_ENABLED=1
G4W_CHECKIN_MIN_INTERVAL_MS=600000
G4W_CHECKIN_MAX_INTERVAL_MS=5400000

# F1 transcript read path: legacy (default) | daily_primary | mirror_primary (stub→legacy)
# Keep legacy in production; daily_primary is for shadow/compare only —
# never set daily_primary as production main-read env.
# G4W_F1_READ_PATH=legacy

# --- Vector retrieval (S7; default ON; orthogonal to hybrid main-read) ---
# Unset / empty → enabled. One-key rollback: G4W_VECTOR_RETRIEVAL=0
# Explicit off tokens: 0, false, off, no, disable, disabled
# G4W_VECTOR_RETRIEVAL=0
#
# Sandbox index root lives under BBS_CWD/workspace/sandbox/vector_index/
# (CODE default BBS_CWD may still point at an older hive window — set for R1/evidence).
# G4W_BBS_CWD=
#
# Allow unit-test temp paths that contain sandbox+vector_index segments:
# G4W_VECTOR_SANDBOX_ALLOW_TEMP=0
#
# Text hybrid main-read (NOT vector). Leave as production policy requires.
# G4W_HYBRID_MAIN_READ=
#
# Do not write vector indexes under DATA/hybrid or daily_primary trees.

# --- Embedding (S5+). Env names only; no secret values. ---
# EMBEDDING_PROVIDER=ark|openai|hash
# EMBEDDING_API_KEY=          # optional; else ARK_API_KEY or OPENAI_API_KEY
# EMBEDDING_BASE_URL=         # optional; ARK/OpenAI defaults in code
# EMBEDDING_MODEL=            # required for remote; unset → hash, no network
# EMBEDDING_DIM=              # optional; else DEFAULT_DIM (384) or caller dim
# EMBEDDING_TIMEOUT_S=30
# EMBEDDING_BATCH_SIZE=16
#
# S6/S7 production index (parallel tree; not under DATA).
# Read resolve: env G4W_VECTOR_INDEX_DIR → else DEFAULT_PROD if ready → sandbox.
# Preferred default path (code DEFAULT_PROD_INDEX_DIR):
#   runtime/G4W-vector-index
# G4W_VECTOR_INDEX_DIR=runtime/G4W-vector-index
# G4W_VECTOR_INDEX_MAX_ITEMS=5000

